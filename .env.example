# Development Environment Configuration

# API Configuration
VITE_API_BASE_URL=
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_DEVTOOLS=true

# Azure AD Configuration
VITE_CLIENT_ID=
VITE_TENANT_ID=
VITE_REDIRECT_URI=http://localhost:3000/

# AWS Configuration
VITE_REPOSITORY_NAME=aws-whitelist-config
VITE_AWS_REGION=eu-west-1

# Application
VITE_APP_NAME=Self-Service Whitelisting Portal
VITE_APP_VERSION=2.0.0
VITE_ENVIRONMENT=development

# Client-side Route Paths
VITE_ROUTE_HOME=/
VITE_ROUTE_LOGIN=/login
VITE_ROUTE_DASHBOARD=/dashboard
VITE_ROUTE_REQUESTS=/requests
VITE_ROUTE_REQUESTS_CREATE=/requests/create
VITE_ROUTE_REQUEST_DETAILS=/requests/:id
VITE_ROUTE_HELP=/help
VITE_ROUTE_NOT_FOUND=/404
VITE_ROUTE_PROFILE=/profile
VITE_ROUTE_SETTINGS=/settings
VITE_ROUTE_WHITELIST=/whitelist

# Temporary static code to unlock ADMIN-gated UI (Settings page), until
# real Azure AD ADMIN app-role assignment is set up. Leave empty/unset
# to disable the unlock UI entirely. NOT a secret: this is a Vite env
# var, so it's compiled into the public JS bundle in plain text and is
# visible to anyone via view-source/devtools. It only toggles which
# admin buttons render in the browser - the backend does not check it
# and has no server-side authorization of its own yet either.
VITE_ADMIN_ACCESS_CODE=

# Available Markets (comma-separated "CODE:Name" pairs)
VITE_AVAILABLE_MARKETS=UK:United Kingdom,US:United States,DE:Germany,FR:France,ES:Spain,IT:Italy,NL:Netherlands,BE:Belgium,SE:Sweden,NO:Norway,DK:Denmark,FI:Finland,PL:Poland,CZ:Czech Republic,AT:Austria,CH:Switzerland,IE:Ireland,PT:Portugal,GR:Greece,HU:Hungary
