# Development Environment Configuration

# API Configuration
VITE_API_BASE_URL=
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_DEVTOOLS=true

# Azure AD Configuration
VITE_CLIENT_ID=
VITE_TENANT_ID=
VITE_REDIRECT_URI=http://localhost:3000/

# AWS Configuration
VITE_REPOSITORY_NAME=aws-whitelist-config
VITE_AWS_REGION=eu-west-1
# AWS account ID per environment (DEV/QA/PRD typically each have their own
# account) - used to render the Matillion agent role ARN (with a one-click
# copy) on Current Whitelist and Request Details. Leave any of these unset
# to simply not show an ARN for that environment.
VITE_AWS_ACCOUNT_ID_DEV=111111111111
VITE_AWS_ACCOUNT_ID_QA=222222222222
VITE_AWS_ACCOUNT_ID_PRD=333333333333

# Application
VITE_APP_NAME=Self-Service Whitelisting Portal
VITE_APP_VERSION=2.0.0
VITE_ENVIRONMENT=development

# Client-side Route Paths
VITE_ROUTE_HOME=/
VITE_ROUTE_LOGIN=/login
VITE_ROUTE_DASHBOARD=/dashboard
VITE_ROUTE_REQUESTS=/requests
VITE_ROUTE_REQUESTS_CREATE=/requests/create
VITE_ROUTE_REQUEST_DETAILS=/requests/:id
VITE_ROUTE_HELP=/help
VITE_ROUTE_NOT_FOUND=/404
VITE_ROUTE_PROFILE=/profile
VITE_ROUTE_SETTINGS=/settings
VITE_ROUTE_WHITELIST=/whitelist

# Markets are read from the config repo (one folder per market code) by the
# backend. This list is only used for display names (CODE:Name) and as a
# fallback when the repository can't be reached.
# Available Markets (comma-separated "CODE:Name" pairs)
VITE_AVAILABLE_MARKETS=UK:United Kingdom,US:United States,DE:Germany,FR:France,ES:Spain,IT:Italy,NL:Netherlands,BE:Belgium,SE:Sweden,NO:Norway,DK:Denmark,FI:Finland,PL:Poland,CZ:Czech Republic,AT:Austria,CH:Switzerland,IE:Ireland,PT:Portugal,GR:Greece,HU:Hungary

# Persistent integration-scope disclaimer, shown on every page (see
# src/components/IntegrationDisclaimer.tsx). Explains that portal-side
# whitelisting may only be one part of the overall integration process.
# Set to "false" to hide the banner entirely.
VITE_SHOW_INTEGRATION_DISCLAIMER=true
VITE_INTEGRATION_DISCLAIMER_TEXT=Whitelisting through this portal may only be one part of the overall integration process. Additional client-side configuration may also be required.

# Documentation links shown alongside the disclaimer above (comma-separated
# "Label:URL" pairs). Leave unset to show the disclaimer text with no links.
VITE_DOCUMENTATION_LINKS=Integration Guide:https://docs.example.com/integration,Client-Side Setup:https://docs.example.com/client-setup

# Representative cross-account IAM policy actions per resource type, used
# to render a policy preview (Idea #18) before/after submitting a request.
# NOT the real template used by the agent role's actual policy - that
# lives outside this repo. Comma-separated IAM actions. Update these once
# the real template is available; nothing else needs to change.
VITE_POLICY_TEMPLATE_S3=s3:GetObject,s3:ListBucket
VITE_POLICY_TEMPLATE_SECRETS=secretsmanager:GetSecretValue,secretsmanager:DescribeSecret
VITE_POLICY_TEMPLATE_KMS=kms:Decrypt,kms:DescribeKey
VITE_POLICY_TEMPLATE_LAMBDA=lambda:InvokeFunction

# Troubleshooting page (self-service issue search). The portal's own built-in
# articles are always searched; these lists add more. Format for all three:
#   Title|URL|keywords|summary;Title|URL|keywords|summary;...
# Entries are split on ";" and fields on "|". Only Title and URL are required.
# keywords/summary are what the fuzzy search matches on besides the title
# (the browser can't read the page content), so put the words people would
# actually type: error text, synonyms, product names.
# To search the pages' real text as well, the BACKEND can read them with a
# service account stored in Secrets Manager: set confluence_page_urls and
# confluence_secret_id in the Terraform stack (see the Confluence section of main.tf).
# Pages are matched to the entries here by URL.
# Example:
#   Whitelisting FAQ|https://confluence.example.com/display/DPC/FAQ|queue stuck pending verification|Answers to the most common whitelisting questions
VITE_TROUBLESHOOTING_CONFLUENCE_PAGES=
VITE_TROUBLESHOOTING_INTERNAL_DOCS=
# Defaults to the public Matillion docs home when empty.
VITE_TROUBLESHOOTING_MATILLION_DOCS=
# "Didn't solve it? Raise a ticket" button target. Empty hides the button.
VITE_SUPPORT_TICKET_URL=
VITE_SUPPORT_TICKET_LABEL=Support ticket portal
