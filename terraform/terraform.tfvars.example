# Copy this file to terraform.tfvars, then adjust the deployed portal origin.
# Keep localhost:3000 while developing the Vite app locally.
cors_allow_origins = [
  "http://localhost:3000",
  "http://localhost:5173",
  # "https://portal.example.com",
]

# GitOps PR reviewers + notifications (optional - leave empty/unset to disable)
pr_approver_usernames = [
  # "jdoe",
  # "asmith",
]
pr_approver_emails = [
  # "jdoe@example.com",
  # "asmith@example.com",
]
# Must be a verified SES identity (email or domain) in this account/region.
domain = ""

# Required - the GitOps Lambda fails on every invocation until these are set.
bitbucket_url  = "" # e.g. "https://bitbucket.example.com"
project_key    = "" # e.g. "DPC"
repo_name      = "" # e.g. "aws-whitelist-config"
repo_base_path = "" # e.g. "environments" - holds <market>/values.<env>.yaml
